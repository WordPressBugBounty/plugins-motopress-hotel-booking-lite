            "Accommodation": [
                "\u041f\u043e\u043c\u0435\u0448\u043a\u0430\u043d\u043d\u044f"
            ],
            "Booking Rules": [
                "\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u0431\u0440\u043e\u043d\u044e\u0432\u0430\u043d\u043d\u044f"
            ],
            "Seasons": [
                "\u0421\u0435\u0437\u043e\u043d\u0438"
