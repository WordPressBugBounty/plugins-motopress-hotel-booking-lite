            "Rates": [
                "\u0422\u0430\u0440\u0438\u0444\u0438"
            ],
            "Period": [
                "\u041f\u0435\u0440\u0456\u043e\u0434"
            ],
            "Quick Start Guide": [
                "\u041a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043f\u043e\u0441\u0456\u0431\u043d\u0438\u043a"
            ],
            "Get familiar with the main interface and key features of the calendar.": [
                "\u041e\u0437\u043d\u0430\u0439\u043e\u043c\u0442\u0435\u0441\u044f \u0437 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u043e\u043c \u0456 \u043a\u043b\u044e\u0447\u043e\u0432\u0438\u043c\u0438 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u044f\u043c\u0438 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044f."
            ],
            "Select a period to display. Use the arrows to navigate and the refresh button to update data.": [
                "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043f\u0435\u0440\u0456\u043e\u0434 \u0434\u043b\u044f \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0441\u0442\u0440\u0456\u043b\u043a\u0438 \u0434\u043b\u044f \u043d\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0457 \u0442\u0430 \u043a\u043d\u043e\u043f\u043a\u0443 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445."
            ],
            "View Options": [
                "\u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"
            ],
            "Display bookings in the Calendar or List view. Use filters to show all accommodations or specific ones.": [
                "\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0430\u0439\u0442\u0435 \u0431\u0440\u043e\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0443 \u0432\u0438\u0433\u043b\u044f\u0434\u0456 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044f \u0430\u0431\u043e \u0441\u043f\u0438\u0441\u043a\u0443. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0444\u0456\u043b\u044c\u0442\u0440\u0438, \u0449\u043e\u0431 \u043f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0432\u0441\u0456 \u043f\u043e\u043c\u0435\u0448\u043a\u0430\u043d\u043d\u044f \u0430\u0431\u043e \u043b\u0438\u0448\u0435 \u0432\u0438\u0431\u0440\u0430\u043d\u0456."
            ],
            "Timeline": [
                "\u0427\u0430\u0441\u043e\u0432\u0430 \u0448\u043a\u0430\u043b\u0430"
            ],
            "The timeline shows the selected period and can be scrolled to view additional dates.": [
                "\u0427\u0430\u0441\u043e\u0432\u0430 \u0448\u043a\u0430\u043b\u0430 \u043f\u043e\u043a\u0430\u0437\u0443\u0454 \u0432\u0438\u0431\u0440\u0430\u043d\u0438\u0439 \u043f\u0435\u0440\u0456\u043e\u0434. \u041f\u0440\u043e\u043a\u0440\u0443\u0447\u0443\u0439\u0442\u0435 \u0457\u0457, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0456\u043d\u0448\u0456 \u0434\u0430\u0442\u0438."
            ],
            "Create seasons to set prices or booking rules for specific periods.": [
                "\u0421\u0442\u0432\u043e\u0440\u044e\u0439\u0442\u0435 \u0441\u0435\u0437\u043e\u043d\u0438, \u0449\u043e\u0431 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0432\u0430\u0442\u0438 \u0446\u0456\u043d\u0438 \u0430\u0431\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0431\u0440\u043e\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0434\u043b\u044f \u043e\u043a\u0440\u0435\u043c\u0438\u0445 \u043f\u0435\u0440\u0456\u043e\u0434\u0456\u0432."
            ],
            "View your accommodations, prices, bookings, and booking rules.": [
                "\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0430\u0439\u0442\u0435 \u043f\u043e\u043c\u0435\u0448\u043a\u0430\u043d\u043d\u044f, \u0446\u0456\u043d\u0438, \u0431\u0440\u043e\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0431\u0440\u043e\u043d\u044e\u0432\u0430\u043d\u043d\u044f."
            ],
            "Working Area": [
                "\u0420\u043e\u0431\u043e\u0447\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u044c"
            ],
            "View your bookings and blocked availability. Choose a date range to create a new booking or block.": [
                "\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0430\u0439\u0442\u0435 \u0431\u0440\u043e\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u0456 \u043f\u0435\u0440\u0456\u043e\u0434\u0438. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0434\u0456\u0430\u043f\u0430\u0437\u043e\u043d \u0434\u0430\u0442, \u0449\u043e\u0431 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043d\u043e\u0432\u0435 \u0431\u0440\u043e\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0430\u0431\u043e \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u0456."
            ],
            "Use rates to set prices for seasons or individual days.": [
                "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0442\u0430\u0440\u0438\u0444\u0438, \u0449\u043e\u0431 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0432\u0430\u0442\u0438 \u0446\u0456\u043d\u0438 \u0434\u043b\u044f \u0441\u0435\u0437\u043e\u043d\u0456\u0432 \u0430\u0431\u043e \u043e\u043a\u0440\u0435\u043c\u0438\u0445 \u0434\u043d\u0456\u0432."
            ],
            "Set rules for specific periods or individual days, such as allowed check-in days and min or max length of stay.": [
                "\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0439\u0442\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0434\u043b\u044f \u043e\u043a\u0440\u0435\u043c\u0438\u0445 \u043f\u0435\u0440\u0456\u043e\u0434\u0456\u0432 \u0430\u0431\u043e \u0434\u043d\u0456\u0432, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 \u0434\u043e\u0437\u0432\u043e\u043b\u0435\u043d\u0456 \u0434\u043d\u0456 \u043f\u0440\u0438\u0431\u0443\u0442\u0442\u044f \u0442\u0430 \u043c\u0456\u043d\u0456\u043c\u0430\u043b\u044c\u043d\u0443 \u0447\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0443 \u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u043d\u043d\u044f."
            ]
        }
    }
